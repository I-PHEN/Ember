# Scaffold database (Prisma) — the video studio itself is in-memory,
# so a local SQLite path is all this needs.
DATABASE_URL="file:./db/custom.db"

# The AI stages (director / transcript planner / scene writers / voice)
# call GLM models server-side via z-ai-web-dev-sdk, which reads its own
# configuration from the runtime environment.

# AI provider — Google AI Studio (free tier: chat + TTS from one key)
# Get a key at https://aistudio.google.com (no credit card needed)
GEMINI_API_KEY=
# Optional overrides:
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MODEL_LITE=gemini-3.8-flash-lite
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_TTS_VOICE=Aoede
