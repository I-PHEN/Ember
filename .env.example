# Durable jobs, scene checkpoints and audio recordings use this database.
# SQLite needs a persistent disk shared by the web process and worker.
# Initialize additive job tables with npm run db:jobs:init.
DATABASE_URL="file:./db/custom.db"

# Start the web app with npm run dev and generation with npm run worker.
# See docs/durable-generation.md before choosing production hosting.

# AI provider — Google AI Studio (free tier: chat + TTS from one key)
# Get a key at https://aistudio.google.com (no credit card needed)
GEMINI_API_KEY=
# Optional overrides:
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MODEL_LITE=gemini-3.8-flash-lite
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_TTS_VOICE=Aoede
