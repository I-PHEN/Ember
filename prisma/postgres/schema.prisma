// This is your Prisma schema file for Ember
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output = "../../node_modules/@prisma/postgres-client"
}

datasource db {
  // Generated by tooling/postgres-schema.mjs; edit canonical models instead.
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  projects      Project[]
  galleryPosts  GalleryPost[]
}

model Project {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  messages      Message[]
  videoVersions VideoVersion[]
}

model Message {
  id            String         @id @default(cuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role          String         // "user" or "ai"
  content       String         // The text prompt or AI response
  createdAt     DateTime       @default(now())

  // An AI message might generate a specific version of the video
  videoVersion  VideoVersion?
}

model VideoVersion {
  id            String         @id @default(cuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Ties this version to the exact chat prompt that created it
  messageId     String?        @unique
  message       Message?       @relation(fields: [messageId], references: [id], onDelete: SetNull)

  // Stored as stringified JSON (until we migrate to Postgres 'Json' type)
  script        String         // The Pedagogue's JSON SolveScript
  timeline      String?        // The compiled visual timeline data

  createdAt     DateTime       @default(now())
  galleryPost   GalleryPost?
}

model GalleryPost {
  id             String       @id @default(cuid())
  publisherId    String
  publisher      User         @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  // The public gallery post wraps around one specific, polished VideoVersion
  videoVersionId String       @unique
  videoVersion   VideoVersion @relation(fields: [videoVersionId], references: [id], onDelete: Restrict)

  title          String
  description    String?
  views          Int          @default(0)
  upvotes        Int          @default(0)
  createdAt      DateTime     @default(now())
}

// Durable execution state; all writers are fenced by the lease token.
model VideoJobRecord {
  id          String   @id
  state       String
  status      String
  leaseToken  String?
  leaseUntil  DateTime?
  attempts    Int      @default(0)
  dispatchAcknowledgedAt DateTime?
  nextRunAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, nextRunAt, leaseUntil])
}

// Audio is persisted before a scene can count as voiced.
model NarrationAsset {
  key         String   @id
  data        Bytes
  createdAt   DateTime @default(now())
}

// Atomic global admission budget for hosted generation (UTC day).
model GenerationQuotaDay {
  day  String @id
  used Int    @default(0)
}
